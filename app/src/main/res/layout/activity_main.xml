<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_background">

    <TextView
        android:id="@+id/titleSleepAnchorX"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SleepAnchorX"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/inputCardSleepAnchorX"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="26dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/titleSleepAnchorX"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:gravity="center_horizontal">

            <EditText
                android:id="@+id/editTextUsualSleep"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Usual sleep time (HH:mm, 24h)"
                android:background="@drawable/rounded_input"
                android:padding="10dp"
                android:inputType="time"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/editTextTodayBed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Today bedtime (HH:mm, 24h)"
                android:background="@drawable/rounded_input"
                android:padding="10dp"
                android:inputType="time"
                android:layout_marginBottom="14dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCalculateSleepAnchorX"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CALCULATE"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/blue_gradient"
                android:textSize="19sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/resultCardSleepAnchorX"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#EDE7F6"
        app:layout_constraintTop_toBottomOf="@id/inputCardSleepAnchorX"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/textSleepAnchorXResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stability score will appear here."
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopySleepAnchorX"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="COPY"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/blue_gradient"
                android:textSize="17sp"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnShareSleepAnchorX"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SHARE"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/blue_gradient"
                android:textSize="17sp"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetSleepAnchorX"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="RESET"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/blue_gradient"
                android:textSize="17sp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>